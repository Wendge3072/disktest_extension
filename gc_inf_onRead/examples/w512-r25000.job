; Generated profile. GC_START is measured from started.tsv, not fio ramp_time.
; A regular-file or DEVICE_BYTES-only dry run is not evidence of QLC IO.
[global]
ioengine=libaio
direct=1
filename=/dev/vda
numjobs=1
time_based=1
runtime=180
ramp_time=60
group_reporting=0
clat_percentiles=1
percentile_list=50:95:99:99.9:99.99
log_avg_msec=1000
log_unix_epoch=1

[foreground_write]
rw=write
bs=64k
iodepth=128
rate=,512m
offset=11633520148480
size=137438953472
io_size=137438953472
randseed=9001
write_bw_log=/tmp/read-w512_foreground_write
write_iops_log=/tmp/read-w512_foreground_write

[foreground_read]
rw=randread
bs=4k
iodepth=32
rate_iops=25000
offset=0
size=9808158654464
randseed=2252
write_bw_log=/tmp/read-w512_foreground_read
write_iops_log=/tmp/read-w512_foreground_read
