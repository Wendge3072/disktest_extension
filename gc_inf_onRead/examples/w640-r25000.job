; Generated profile. GC_START is measured from started.tsv, not fio ramp_time.
; A regular-file or DEVICE_BYTES-only dry run is not evidence of QLC IO.
[global]
ioengine=libaio
direct=1
filename=/dev/vda
numjobs=1
time_based=1
runtime=600
group_reporting=0
log_avg_msec=1000
log_hist_msec=1000
log_hist_coarseness=0
log_unix_epoch=1

[foreground_write]
rw=randwrite
bs=64k
iodepth=128
rate=,640m
offset=0
size=429496729600
io_size=429496729600
randseed=9001
write_bw_log=/tmp/disktest-extension-example-w640-r25000_foreground_write
write_iops_log=/tmp/disktest-extension-example-w640-r25000_foreground_write
write_hist_log=/tmp/disktest-extension-example-w640-r25000_foreground_write

[foreground_read]
rw=randread
bs=4k
iodepth=32
rate_iops=25000
offset=2199023255552
size=1099511627776
randseed=2252
write_bw_log=/tmp/disktest-extension-example-w640-r25000_foreground_read
write_iops_log=/tmp/disktest-extension-example-w640-r25000_foreground_read
write_hist_log=/tmp/disktest-extension-example-w640-r25000_foreground_read
