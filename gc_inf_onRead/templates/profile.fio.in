; Generated profile. GC_START is measured from started.tsv, not fio ramp_time.
; A regular-file or DEVICE_BYTES-only dry run is not evidence of QLC IO.
[global]
ioengine=libaio
direct=1
filename=@@DEVICE@@
numjobs=1
time_based=1
runtime=@@RUNTIME@@
group_reporting=0
log_avg_msec=1000
log_hist_msec=1000
log_hist_coarseness=0
log_unix_epoch=1

[foreground_write]
rw=randwrite
bs=64k
iodepth=@@WRITE_QD@@
rate=,@@WRITE_MIB@@m
offset=@@WRITE_OFFSET@@
size=@@WRITE_SIZE@@
io_size=@@WRITE_SIZE@@
randseed=@@WRITE_SEED@@
write_bw_log=@@LOG_PREFIX@@_foreground_write
write_iops_log=@@LOG_PREFIX@@_foreground_write
write_hist_log=@@LOG_PREFIX@@_foreground_write

[foreground_read]
rw=randread
bs=4k
iodepth=@@READ_QD@@
rate_iops=@@READ_IOPS@@
offset=@@READ_OFFSET@@
size=@@READ_SIZE@@
randseed=@@READ_SEED@@
write_bw_log=@@LOG_PREFIX@@_foreground_read
write_iops_log=@@LOG_PREFIX@@_foreground_read
write_hist_log=@@LOG_PREFIX@@_foreground_read
